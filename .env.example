# Copy this file to .env (which is gitignored) and fill in your own CognoDB Cloud instance
# details from https://console.cognodb.com — never commit real credentials.
#
# For local `mvn spring-boot:run` you can export these instead of using a .env loader, e.g.:
#   export $(grep -v '^#' .env | xargs) && mvn spring-boot:run

COGNODB_URI=bolt+s://<your-instance-id>.databases.cognodb.cloud
COGNODB_USERNAME=cognodb
COGNODB_PASSWORD=<your-generated-password>
COGNODB_DATABASE=neo4j

# Optional tuning (defaults shown)
COGNODB_CONNECTION_TIMEOUT_SECONDS=10
COGNODB_MAX_RETRY_TIME_SECONDS=5

# Demo login (single fixed account, see AuthController) - change these before deploying anywhere
# public; defaults shown match what's baked into application.yml if left unset.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin@123

PORT=8080
